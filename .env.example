# Porta da aplicação
PORT=8080

# Banco de dados (PostgreSQL + pgvector)
# Para local com o docker compose deste repo, os padrões acervo/dev já funcionam.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/acervo
SPRING_DATASOURCE_USERNAME=acervo
SPRING_DATASOURCE_PASSWORD=dev

# OpenAI (chat e embeddings)
OPENAI_API_KEY=sk-sua-chave-openai

# Origens permitidas no CORS (front local)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Chaves RSA do JWT (gere com openssl - veja o README)
JWT_PRIVATE_KEY=file:private.pem
JWT_PUBLIC_KEY=file:public.pem

# AWS S3 (armazenamento dos arquivos)
S3_REGION=us-east-1
S3_ACCESS_KEY=sua_access_key
S3_SECRET_KEY=seu_secret_key
S3_BUCKET_NAME=nome-do-bucket